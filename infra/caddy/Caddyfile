# Trusty edge proxy — terminates HTTPS for the public domain and routes into
# the compose network. Certificates come from Let's Encrypt automatically
# (needs ports 80+443 reachable from the internet; HTTP→HTTPS redirect is
# built in). PUBLIC_DOMAIN + ACME_EMAIL come from .env via docker-compose.
{
	# Default keeps the parser happy when ACME_EMAIL is unset (local dev) —
	# an empty {$VAR} placeholder would be a zero-arg parse error.
	email {$ACME_EMAIL:dev@localhost.invalid}
}

{$PUBLIC_DOMAIN:localhost} {
	# Keycloak lives under /auth (KC_HTTP_RELATIVE_PATH) so one domain serves
	# both app and IdP — no path stripping: keycloak itself expects /auth/*.
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# Everything else is the Next.js app (BFF included). Internal network —
	# the web container no longer needs its host port for public traffic.
	handle {
		reverse_proxy web:3000
	}
}

# Community Spaces — same app, the BFF scopes data by Host (summit space,
# Iranians-in-Armenia space). Certs come from ACME once DNS records exist.
summit.{$PUBLIC_DOMAIN:localhost}, irham.{$PUBLIC_DOMAIN:localhost} {
	reverse_proxy web:3000
}

# Langfuse — LLM tracing/eval console. Has its own login (NEXTAUTH), so no
# basic-auth layer here; NEXTAUTH_URL must match this public URL.
langfuse.{$PUBLIC_DOMAIN:localhost} {
	reverse_proxy langfuse:3000
}

# Kibana (observability profile) — basic-auth protected; hash generated with
# `docker compose run --rm caddy caddy hash-password`. No-op until the DNS
# record for kibana.<domain> exists and KIBANA_PASS_HASH is set.
kibana.{$PUBLIC_DOMAIN:localhost} {
	basic_auth {
		{$KIBANA_USER:admin} {$KIBANA_PASS_HASH}
	}
	reverse_proxy kibana:5601
}
