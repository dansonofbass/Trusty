# Variant of the edge proxy that serves a PROVIDED certificate instead of
# obtaining one via ACME — for DNS-01 issued certs (e.g. certbot manual with
# TXT records) or certs from a provider. Select it in .env:
#   CADDY_CONFIG=Caddyfile.customcert
#   CERTS_DIR=/etc/letsencrypt/live/mytrusty.app   # holds fullchain.pem + privkey.pem
# Renewal is YOUR job (manual DNS-01 can't auto-renew): re-run certbot, then
# `docker compose restart caddy`.
{$PUBLIC_DOMAIN} {
	tls /certs/fullchain.pem /certs/privkey.pem

	handle /auth/* {
		reverse_proxy keycloak:8080
	}
	handle {
		reverse_proxy web:3000
	}
}

# Community Spaces — same app, the BFF scopes data by Host. These names use
# ACME (needs DNS records); if your provided cert is a wildcard, add the same
# `tls /certs/...` lines here instead.
summit.{$PUBLIC_DOMAIN:localhost}, irham.{$PUBLIC_DOMAIN:localhost} {
	reverse_proxy web:3000
}

# Kibana (observability profile) — basic-auth protected; hash generated with
# `docker compose run --rm caddy caddy hash-password`. No-op until the DNS
# record for kibana.<domain> exists and KIBANA_PASS_HASH is set.
kibana.{$PUBLIC_DOMAIN:localhost} {
	basic_auth {
		{$KIBANA_USER:admin} {$KIBANA_PASS_HASH}
	}
	reverse_proxy kibana:5601
}
