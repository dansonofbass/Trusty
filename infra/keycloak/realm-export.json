{
  "realm": "constellation",
  "enabled": true,
  "displayName": "Trusty",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Trusty administrator \u2014 may set the extraction model."
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@constellation.dev",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "constellation-web",
      "name": "Trusty Web (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "constellation-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback",
        "http://${PUBLIC_HOST}:3000/api/auth/callback",
        "https://${PUBLIC_HOST}/api/auth/callback",
        "${APP_PUBLIC_URL}/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://${PUBLIC_HOST}:3000",
        "https://${PUBLIC_HOST}",
        "${APP_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://${PUBLIC_HOST}:3000/*##https://${PUBLIC_HOST}/*##${APP_PUBLIC_URL}/*",
        "backchannel.logout.session.required": "true"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email"
      ]
    }
  ],
  "loginTheme": "trusty"
}
